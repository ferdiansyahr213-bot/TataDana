# ====================================================================
# VARIABEL LINGKUNGAN PRODUKSI TATADANA FINTECH (.env.production)
# Salin variabel ini ke Project Settings > Environment Variables di Vercel
# ====================================================================

# 1. SUPABASE & POSTGRESQL DATABASE
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# 2. SISTEM AUTENTIKASI & KODE OTP KRIPTOGRAFIS
# Buat string acak 32+ karakter untuk salt HMAC-SHA256
OTP_SECRET="tatadana_production_super_secret_otp_hmac_salt_key_2026"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# 3. GATEWAY PENGIRIM PESAN (PILIH SALAH SATU ATAU KOMBINASIKAN)
# Opsi Utama: Fonnte WhatsApp API (Sangat direkomendasikan untuk Indonesia - https://fonnte.com)
FONNTE_API_TOKEN="your_fonnte_device_token_here"

# Opsi Cadangan Email: Resend API (https://resend.com)
RESEND_API_KEY="re_1234567890abcdef"
RESEND_FROM_EMAIL="TataDana Auth <auth@tatadana.id>"

# Opsi Cadangan SMS: Twilio API (https://twilio.com)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# 4. OPEN FINANCE & AGREGATOR PERBANKAN INDONESIA (BRICK API - https://onebrick.io)
BRICK_ENVIRONMENT="production" # atau "sandbox" saat tahap testing
BRICK_CLIENT_ID="your_brick_client_id_here"
BRICK_CLIENT_SECRET="your_brick_client_secret_here"
BRICK_WEBHOOK_SECRET="your_brick_webhook_signing_secret"

# Kunci Enkripsi AES-256-GCM (Wajib 64 Karakter Hexadecimal = 32 Bytes)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 5. KEAMANAN SESI & APLIKASI
JWT_SECRET="your_jwt_production_signing_key_32_characters_minimum"
ADMIN_PASSWORD="YourStrongAdminPassword2026!" # Password otentikasi administrator utama
NEXT_PUBLIC_APP_URL="https://tatadana.vercel.app"
NEXT_PUBLIC_ADMIN_WA_NUMBER="087730370324"
NEXT_PUBLIC_ADMIN_WA="087730370324"
NEXT_PUBLIC_ADMIN_EMAIL="ferdiansyahr213@gmail.com"

# 6. AI ASSISTANT & TELEGRAM BOT (OPSIONAL / INTEGRASI LANJUTAN)
TELEGRAM_BOT_TOKEN="8909813540:AAFdPSHsxhwJsOjxsl5oyxTaF5POy3jRLOI"
TELEGRAM_ADMIN_CHAT_ID="8807546522"
TELEGRAM_WEBHOOK_SECRET="your_telegram_webhook_secret"
GEMINI_API_KEY="your_gemini_api_key_for_ai"
