# TataDana Environment Variables
# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_BASE_URL=https://your-tatadana-domain.com

# AI Multi-Provider API Keys (Also configurable via Admin Dashboard)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase (Postgres & Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=tatadana-reports

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_ADMIN_EMAIL=admin@tatadana.id
TIMEZONE=Asia/Jakarta
